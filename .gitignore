# --- Yelp raw data (download separately from https://www.yelp.com/dataset) ---
Yelp_data_set/
*.tar
yelp_academic_dataset_*.json

# --- Generated DuckDB databases (rebuild with build_yelp_databases.py) ---
yelp_dbs/
*.duckdb
*.duckdb.wal

# --- Query extracts / derived data (keep the small one the app reads at runtime) ---
extracts/*
!extracts/rec_business.parquet

# --- Trained models / app artifacts (keep what app.py actually loads; rest is rebuildable) ---
models/*
!models/als.npz
!models/app/
models/app/*
!models/app/history.parquet
!models/app/snippets.parquet
!models/app/user_home.parquet
!models/app/users.parquet

# --- Python ---
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
env/

# --- OS / editor cruft ---
.DS_Store
__MACOSX/
Thumbs.db
.vscode/
